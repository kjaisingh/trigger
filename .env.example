PORT=3001
BASE_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Frontend (Vite reads these directly, must be prefixed VITE_)
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon key>"
VITE_API_URL=http://localhost:3001

# Backend
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role key>"

# Groq — app-default free LLM key used to parse trigger prompts
GROQ_API_KEY="<groq api key>"

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="<public key>"
VAPID_PRIVATE_KEY="<private key>"
VITE_VAPID_PUBLIC_KEY="<same public key, exposed to the frontend>"
VAPID_SUBJECT="mailto:you@example.com"

# TheSportsDB free test key ("3"), swap in a paid key if you register one
SPORTSDB_API_KEY=3

# Shared secret the pg_cron job must send so /api isn't the only thing gating the Edge Function
CRON_SHARED_SECRET="<random string>"
